# Copy to .env.deploy and adjust before production deploy.
DOCKERHUB_USER=sidonweb
IMAGE_TAG=latest

# Public hostname or IP — must match what you used when building frontend images.
DEPLOY_HOST=your.server.ip.or.domain

POSTGRES_PASSWORD=change-me
SEED_ON_START=true
SEED_PROFILE=scale
DEMO_MODE=true

ECOM_API_PORT=3002
COPILOT_API_PORT=3001
PLAYWRIGHT_PORT=8931
ECOM_WEB_PORT=5173
DASHBOARD_PORT=5174
