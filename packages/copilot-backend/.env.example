# copilot_role owns experiment CRUD; the agent reads via a SELECT-only role.
DATABASE_URL=postgresql://copilot_role:copilot_pw@localhost:5432/copilot
AGENT_DATABASE_URL=postgresql://agent_readonly:agent_pw@localhost:5432/copilot

# LLM provider: "openai" (default) or "xai"
LLM_PROVIDER=openai

# OpenAI (also works for OpenAI-compatible gateways like OpenRouter via OPENAI_BASE_URL)
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://openrouter.ai/api/v1   # uncomment for OpenRouter

# Grok (xAI) — used only when LLM_PROVIDER=xai. Get a key at https://console.x.ai
XAI_API_KEY=xai-xxxxxxxx
XAI_MODEL=grok-3-mini

# Playwright MCP — browser tools for inspecting variant URLs
PLAYWRIGHT_MCP_URL=http://playwright-mcp:8931/mcp
# Containerized Playwright cannot reach the host app through localhost.
PLAYWRIGHT_LOCALHOST_ALIAS=host.docker.internal
USE_PLAYWRIGHT=true

PORT=3001
