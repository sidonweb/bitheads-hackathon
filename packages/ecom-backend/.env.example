# ecom-backend owns event ingestion + the variant flag.
DATABASE_URL=postgresql://ecom_role:ecom_pw@localhost:5432/copilot
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/copilot

# Where the storefront is reachable (used by seed to set variant URLs).
ECOM_WEB_URL=http://localhost:5173

PORT=3002
SEED_ON_START=true
